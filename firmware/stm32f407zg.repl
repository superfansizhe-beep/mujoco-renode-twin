// STM32F407ZGT6 board platform -- the real target part, replacing the
// stock stm32f4_discovery kit (whose 256 KiB SRAM / 2 MiB flash / GPIOJ-K
// and board PHY/LEDs do not exist on our chip: 1 MiB flash, 128 KiB SRAM
// + 64 KiB CCM, ports A-I). Loaded by bot/renode.py.
//
// Declared unsupported on renode 1.17.0 (kept instead of hidden so a
// driver gate cannot silently trust them):
//   - RCC enable gating covers the firmware-used peripherals (rcc_model.cs).
//     Unused peripherals retain stock behavior. The clock tree is pinned to
//     the HSI RESET state (16 MHz everywhere) -- what an unconfigured real
//     F407 actually runs, so firmware timing constants (timer_monotonic.h)
//     are identical in Renode and on the board. The frequencies are NOT
//     RCC-derived; the clock-init milestone must update this file together
//     with the firmware's clock code.
//   - CCM is modeled as plain memory; the real CCM rejects DMA access,
//     which the model does not enforce.

fsmcBank1: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x10000000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00020000

ccm: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x00010000

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

flash_controller: MTD.STM32F4_FlashController @ {
        sysbus 0x40023C00;
        sysbus new Bus.BusMultiRegistration { address: 0x1FFFC000; size: 0x100; region: "optionBytes" }
    }
    flash: flash

usart1: UART.STM32_UART @ sysbus <0x40011000, +0x100>
    -> nvic@37

// USART2's baud-rate generators: two private timers the wire model
// (uart_model.cs) arms per frame, one per direction -- full duplex.
// No firmware touches them; their clock is the same pinned 16 MHz HSI
// tree (see the RCC note above).
uartTxBaud: Timers.STM32_Timer @ sysbus 0x50000000
    frequency: 16000000
    initialLimit: 0xFFFFFFFF

uartRxBaud: Timers.STM32_Timer @ sysbus 0x50001000
    frequency: 16000000
    initialLimit: 0xFFFFFFFF

usart2: UART.UARTWireSim @ sysbus <0x40004400, +0x100>
    txBaud: uartTxBaud
    rxBaud: uartRxBaud
    -> nvic@38

usart3: UART.STM32_UART @ sysbus <0x40004800, +0x100>
    -> nvic@39

uart4: UART.STM32_UART @ sysbus <0x40004C00, +0x100>
    -> nvic@52

uart5: UART.STM32_UART @ sysbus <0x40005000, +0x100>
    -> nvic@53

can1: CAN.STMCAN @ sysbus <0x40006400, +0x400>
    [0-3] -> nvic@[19-22]

can2: CAN.STMCAN @ sysbus <0x40006800, +0x400>
    [0-3] -> nvic@[63-66]
    master: can1

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

pwr: Miscellaneous.STM32_PWR @ sysbus 0x40007000

crc: CRC.STM32_CRC @ sysbus 0x40023000
    series: STM32Series.F4

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40013C00
    numberOfOutputLines: 24
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]
    [16, 17, 18, 22] -> nvic@[1, 41, 42, 3]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x40020000, +0x400>
    modeResetValue: 0xA8000000
    outputSpeedResetValue: 0x0C000000
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16
    invertedAFPins: [[5, 3], [7, 1, 3]]
    [0-15] -> exti@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x40020400, +0x400>
    modeResetValue: 0x00000280
    outputSpeedResetValue: 0x000000C0
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16
    invertedAFPins: [[0, 1, 3], [1, 1, 3], [13, 1], [14, 1, 3], [15, 1, 3]]
    [0-15] -> exti@[0-15]

// PC6/PC7 feed TIM3's encoder inputs (AF2) -- gpio_model.cs gates the
// injected pin state on MODER/AFRL, so a wrong pin map stops counting
// like it would on silicon
gpioPortC: GPIOPort.GPIOPortAFSim @ sysbus <0x40020800, +0x400>
    numberOfAFs: 16
    gatedPins: [6, 7]
    gatedAF: 2
    [0-15] -> exti@[0-15]

// PD12/PD13 feed TIM4 the same way
gpioPortD: GPIOPort.GPIOPortAFSim @ sysbus <0x40020C00, +0x400>
    numberOfAFs: 16
    gatedPins: [12, 13]
    gatedAF: 2
    [0-15] -> exti@[0-15]

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x40021000, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[8, 1], [10, 1], [12, 1]]
    [0-15] -> exti@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x40021400, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x40021800, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x40021c00, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[13, 3], [14, 3], [15, 3]]
    [0-15] -> exti@[0-15]

gpioPortI: GPIOPort.STM32_GPIOPort @ sysbus <0x40022000, +0x400>
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

ethernet: Network.SynopsysEthernetMAC @ sysbus 0x40028000
    -> nvic@61

rom1: Memory.MappedMemory @ sysbus 0x1FFF0000
    size: 0xC000

rom2: Memory.MappedMemory @ sysbus 0x1FFFC400
    size: 0x3C00

spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F4
    IRQ->nvic@35

spi2: SPI.STM32SPI @ sysbus 0x40003800
    series: STM32Series.F4
    IRQ->nvic@36
    DMAReceive->dma1@3

spi3: SPI.STM32SPI @ sysbus 0x40003C00
    series: STM32Series.F4
    IRQ->nvic@51

i2c1: I2C.I2CNackSim @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

// The bring-up IMU at its breakout address (AD0 = GND). The C# model is
// compiled at runtime by bot/renode.py (`include` mpu6050_model.cs) BEFORE
// this platform loads. Its sample values come from the sim-only imu_bench
// region below.
mpu: I2C.MPU6050Sim @ i2c1 0x68

// Simulation-only scratch the device models read their samples from
// (MPU6050: +0x00..+0x24 per mpu6050_model.cs; battery/current:
// +0x28/+0x2C per adc_model.cs) -- NOT a peripheral of the real chip
// (the 0xF0000000 area is vendor space on real silicon; firmware
// never touches it, only the harness writes).
bench: Memory.MappedMemory @ sysbus 0xF0000000
    size: 0x400                // page-aligned minimum

// The battery/current ADC, fed from the bench's millivolt words.
// ADC1's conversion clock: the wire model (adc_model.cs) arms it per
// conversion -- (sampling + 12) x ADCPRE-divider ticks of the same
// pinned 16 MHz HSI tree (RM0090 ch. 13 TCONV). Scratch address, no
// firmware touches it.
adcBaud: Timers.STM32_Timer @ sysbus 0x50002000
    frequency: 16000000
    initialLimit: 0xFFFFFFFF

adc1: Analog.ADC1Sim @ sysbus <0x40012000, +0x100>
    convTimer: adcBaud

i2c2: I2C.STM32F1_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34

i2c3: I2C.STM32F1_I2C @ sysbus 0x40005C00
    EventInterrupt -> nvic@72
    ErrorInterrupt -> nvic@73

dma1: DMA.STM32DMA @ sysbus 0x40026000
    [0-7] -> nvic@[11-17,47]

dma2: DMA.STM32DMA @ sysbus 0x40026400
    [0-7] -> nvic@[56-60,68-70]

rng: Miscellaneous.STM32_RNG @ sysbus 0x50060800
    series: STM32Series.F4
    -> nvic@80

// The hand watchdog (iwdg_model.cs): the stock model stores registers
// but a driven counter never resets the machine (probed 2026-09-29);
// expiry here takes machine.RequestReset() like silicon.
iwdg: Timers.IWDGSim @ sysbus <0x40003000, +0x20>


rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
    AlarmIRQ -> nvic@41

rcc: Miscellaneous.RCCEnableSim @ sysbus 0x40023800
    rtcPeripheral: rtc
    gpioA: gpioPortA
    gpioB: gpioPortB
    gpioC: gpioPortC
    gpioD: gpioPortD
    gpioE: gpioPortE
    gpioF: gpioPortF
    tim1: timer1
    tim2: timer2
    tim3: timer3
    tim4: timer4
    i2c1: i2c1
    usart2: usart2
    adc1: adc1
    Timer9Reset -> timer9@255

// Timer clocks: 16 MHz -- the HSI reset tree (see the RCC note above).
// timer1 is the hand subclass (timer1_model.cs): the stock STM32_Timer
// does not store BDTR (MOE write read 0, probed 2026-09-29) and the
// drive-chain decode gates the plant's duty on MOE.
timer1: Timers.TIM1Sim @ sysbus 0x40010000
    BreakInterrupt -> nvic@24
    UpdateInterrupt -> nvic@25
    [TriggerInterrupt, CommutationInterrupt] -> nvic@[26, 26]
    CaptureCompareInterrupt -> nvic@27
    frequency: 16000000
    initialLimit: 0xFFFF

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    -> nvic@28
    frequency: 16000000
    initialLimit: 0xFFFFFFFF

// The encoder timers are the hand model (enc_model.cs), NOT
// STM32_Timer: Renode 1.17's encoder-mode counting THROWS on the 16-bit
// wrap (real silicon wraps; probes in output/race-integration/). The
// model takes the same OnGPIO edge injections, stores the driver's
// register contract, and wraps CNT like the board -- no nvic lines (the
// firmwares poll CNT). x4 quadrature only, the mode both firmwares set.
timer3: Timers.EncoderCounterSim @ sysbus <0x40000400, +0x400>

timer4: Timers.EncoderCounterSim @ sysbus <0x40000800, +0x400>

timer5: Timers.STM32_Timer @ sysbus 0x40000C00
    -> nvic@50
    frequency: 16000000
    initialLimit: 0xFFFFFFFF

timer6: Timers.STM32_Timer @ sysbus 0x40001000
    -> nvic@54
    frequency: 16000000
    initialLimit: 0xFFFF

timer7: Timers.STM32_Timer @ sysbus 0x40001400
    -> nvic@55
    frequency: 16000000
    initialLimit: 0xFFFF

timer8: Timers.STM32_Timer @ sysbus 0x40010400
    BreakInterrupt -> nvic@43
    UpdateInterrupt -> nvic@44
    [TriggerInterrupt, CommutationInterrupt] -> nvic@[45, 45]
    CaptureCompareInterrupt -> nvic@46
    frequency: 16000000
    initialLimit: 0xFFFF

timer9: Timers.STM32_Timer @ sysbus 0x40014000
    -> nvic@24
    frequency: 16000000
    initialLimit: 0xFFFF

timer10: Timers.STM32_Timer @ sysbus 0x40014400
    -> nvic@25
    frequency: 16000000
    initialLimit: 0xFFFF

timer11: Timers.STM32_Timer @ sysbus 0x40014800
    -> nvic@26
    frequency: 16000000
    initialLimit: 0xFFFF

timer12: Timers.STM32_Timer @ sysbus 0x40001800
    -> nvic@43
    frequency: 16000000
    initialLimit: 0xFFFF

timer13: Timers.STM32_Timer @ sysbus 0x40001C00
    -> nvic@44
    frequency: 16000000
    initialLimit: 0xFFFF

timer14: Timers.STM32_Timer @ sysbus 0x40002000
    -> nvic@45
    frequency: 16000000
    initialLimit: 0xFFFF

// Alternate function mapping connections. For more details see `stm32l071.repl`.
timer1:
    0 -> gpioPortA#08@01 | gpioPortE#09@01 | gpioPortA#07@01 | gpioPortB#13@01 | gpioPortE#08@01
    1 -> gpioPortA#09@01 | gpioPortE#11@01 | gpioPortB#00@01 | gpioPortB#14@01 | gpioPortE#10@01
    2 -> gpioPortA#10@01 | gpioPortE#13@01 | gpioPortB#01@01 | gpioPortB#15@01 | gpioPortE#12@01
    3 -> gpioPortA#11@01 | gpioPortE#14@01

timer2:
    0 -> gpioPortA#00@01 | gpioPortA#05@01 | gpioPortA#15@01
    1 -> gpioPortA#01@01 | gpioPortB#03@01
    2 -> gpioPortA#02@01 | gpioPortB#10@01
    3 -> gpioPortA#03@01 | gpioPortB#11@01

timer3:
    0 -> gpioPortA#06@02 | gpioPortB#04@02 | gpioPortC#06@02
    1 -> gpioPortA#07@02 | gpioPortB#05@02 | gpioPortC#07@02
    2 -> gpioPortB#00@02 | gpioPortC#08@02
    3 -> gpioPortB#01@02 | gpioPortC#09@02

timer4:
    0 -> gpioPortB#06@02 | gpioPortD#12@02
    1 -> gpioPortB#07@02 | gpioPortD#13@02
    2 -> gpioPortB#08@02 | gpioPortD#14@02
    3 -> gpioPortB#09@02 | gpioPortD#15@02

timer5:
    0 -> gpioPortA#00@02 | gpioPortH#10@02
    1 -> gpioPortA#01@02 | gpioPortH#11@02
    2 -> gpioPortA#02@02 | gpioPortH#12@02
    3 -> gpioPortA#03@02 | gpioPortI#00@02

timer8:
    0 -> gpioPortC#06@03 | gpioPortI#05@03 | gpioPortA#05@03 | gpioPortA#07@03 | gpioPortH#13@3
    1 -> gpioPortC#07@03 | gpioPortI#06@03 | gpioPortB#00@03 | gpioPortB#14@03 | gpioPortH#14@3
    2 -> gpioPortC#08@03 | gpioPortI#07@03 | gpioPortB#01@03 | gpioPortB#15@03 | gpioPortH#15@3
    3 -> gpioPortC#09@03 | gpioPortI#02@03

timer9:
    0 -> gpioPortA#02@03 | gpioPortE#05@03
    1 -> gpioPortA#03@03 | gpioPortE#06@03

timer10:
    0 -> gpioPortB#08@03 | gpioPortF#06@03

timer11:
    0 -> gpioPortB#09@03 | gpioPortF#07@03

timer12:
    0 -> gpioPortB#14@09 | gpioPortH#06@09
    1 -> gpioPortB#15@09 | gpioPortH#09@09

timer13:
    0 -> gpioPortA#06@09 | gpioPortF#08@09

timer14:
    0 -> gpioPortA#07@09 | gpioPortF#09@09

gpioPortA:
    0 -> timer2@00 | timer5@00
    1 -> timer2@01 | timer5@01
    2 -> timer2@02 | timer5@02 | timer9@00
    3 -> timer2@03 | timer5@03 | timer9@01
    5 -> timer2@00 | timer8@00
    6 -> timer3@00 | timer13@00
    7 -> timer1@00 | timer3@01 | timer8@00 | timer14@00
    8 -> timer1@00
    9 -> timer1@01
    10 -> timer1@02
    11 -> timer1@03
    15 -> timer2@00

gpioPortB:
    0 -> timer1@01 | timer3@02 | timer8@01
    1 -> timer1@02 | timer3@03 | timer8@02
    3 -> timer2@01
    4 -> timer3@00
    5 -> timer3@01
    6 -> timer4@00
    7 -> timer4@01
    8 -> timer4@02 | timer10@00
    9 -> timer4@03 | timer11@00
    10 -> timer2@02
    11 -> timer2@03
    13 -> timer1@00
    14 -> timer1@01 | timer8@01 | timer12@00
    15 -> timer1@02 | timer8@02 | timer12@01

gpioPortC:
    6 -> timer3@00 | timer8@00
    7 -> timer3@01 | timer8@01
    8 -> timer3@02 | timer8@02
    9 -> timer3@03 | timer8@03

gpioPortD:
    12 -> timer4@00
    13 -> timer4@01
    14 -> timer4@02
    15 -> timer4@03

gpioPortE:
    5 -> timer9@00
    6 -> timer9@01
    8 -> timer1@00
    9 -> timer1@00
    10 -> timer1@01
    11 -> timer1@01
    12 -> timer1@02
    13 -> timer1@02
    14 -> timer1@03

gpioPortF:
    6 -> timer10@00
    7 -> timer11@00
    8 -> timer13@00
    9 -> timer14@00

gpioPortH:
    6 -> timer12@00
    9 -> timer12@01
    10 -> timer5@00
    11 -> timer5@01
    12 -> timer5@02
    13 -> timer8@00
    14 -> timer8@01
    15 -> timer8@02

gpioPortI:
    0 -> timer5@03
    2 -> timer8@03
    5 -> timer8@00
    6 -> timer8@01
    7 -> timer8@02

bitbandPeripherals: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000

bitbandSram: Miscellaneous.BitBanding @ sysbus <0x22000000, +0x200000>
    peripheralBase: 0x20000000

sysbus:
    init:
        ApplySVD @https://dl.antmicro.com/projects/renode/svd/STM32F40x.svd.gz
        Tag <0x40021000, 0x40021003> "GPIOE_MODER" 0xFFFFFFFF
        Tag <0x40021004, 0x40021007> "GPIOE_OTYPER" 0x00000008
        // FLASH and USB tags are required for CubeMX-based projects to pass the initialization phase
        Tag <0x50000010, 0x5000003f> "USB:RESET" 0x80000000
