 "before": {
  "gap": "conversion completed immediately; sample time / ADCPRE did not determine latency (sim-fidelity-gaps 2026-09-29; adc_model.cs header)"
 },
 "after": {
  "model": "TCONV = (SMPR1 sampling + 12) cycles x ADCPRE divider, deferred on the repl-attached adcBaud 16 MHz timer (the ScheduleAction traps make repl timers the only sub-ms mechanism, see uart_model.cs); DR+EOC latch at completion; SWSTART in flight ignored; RCC bus disable or reset drops the in-flight result. Register gotcha caught by the doc-audit round: SMPR1 (0x0C) is channels 10-18, SMPR2 (0x10) is 0-9 -- the first model+test pair read SMPR2 self-consistently wrong, the battery_status '480-cycle SMPR1' line exposed it",
  "gates": {
   "3-cycle vs 480-cycle sampling: ~1.9 vs ~61.5 us, value unchanged": "tests.test_firmware_battery.TestAdcLatency.test_conversion_pays_its_sample_time",
   "wrong ADCPRE (/2 vs /8) stretches the conversion": "tests.test_firmware_battery.TestAdcLatency.test_wrong_adcpre_stretches_the_conversion",
   "SWSTART during a conversion is ignored": "tests.test_firmware_battery.TestAdcLatency.test_swstart_during_a_conversion_is_ignored"
  },
  "regression": "peripheral 79/0 (36.6 s), twin 25/25, race 8/8 (1046 s -- microsecond latency adds no wall cost), all first hand, output/p2-fidelity/*.log",
  "generated_headers": {
   "race": "in sync",
   "twin": "in sync"
  }
 },
